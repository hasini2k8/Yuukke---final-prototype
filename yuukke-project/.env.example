OPENAI_API_KEY=
TRIPO_API_KEY=
GEMINI_API_KEY=
POSTIZ_API_KEY=
# Leave this unchanged for Postiz Cloud. For self-hosted Postiz, use:
# https://your-postiz-backend.example.com/public/v1
POSTIZ_API_URL=https://api.postiz.com/public/v1

# Public URL of the externally hosted Node backend. Leave blank locally.
VITE_API_BASE_URL=
# Root domain used for generated storefront links, e.g. yuukke.com.
VITE_STOREFRONT_DOMAIN=
# Backend CORS configuration (set on the external backend, not Vercel).
FRONTEND_ORIGINS=
CORS_ROOT_DOMAIN=
